{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-setup.ts",
    "src/**/__contracts__/**",
    "src/**/__live__/**"
  ],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/config"
    }
  ]
}
