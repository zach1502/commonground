{
  "name": "@parkshape/terrain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@parkshape/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fetch-terrain": "tsx src/cli/fetch-terrain.ts",
    "fetch-site": "tsx src/cli/fetch-site.ts",
    "fetch-context": "tsx src/cli/fetch-context.ts",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@parkshape/config": "workspace:*",
    "@parkshape/core": "workspace:*",
    "fflate": "0.8.3",
    "geotiff": "3.0.5",
    "proj4": "2.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43"
  }
}
