# Put your own values in .env at the repo root. pnpm dev:local reads it, and git ignores it.

# API server
# Port the Node entry listens on.
PORT=8787
# Browser origin allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:5173

# Terrain adapter
# Source of elevation data for the site grid: static, hrdem or chain (HRDEM, then MRDEM, then static).
TERRAIN_PROVIDER=static

# Site features adapter
# Source of existing trees, paths, and structures: static or vancouver (Vancouver Open Data).
SITE_FEATURES_PROVIDER=static

# Site context adapter
# Source of the streets, sidewalks, bus stops, parking and bikeways around the parcel: static or vancouver (Vancouver Open Data and TransLink GTFS).
SITE_CONTEXT_PROVIDER=static

# Database adapter
# Connection string. pglite:// runs an embedded Postgres on disk; postgres:// connects to a server such as Supabase.
DATABASE_URL=pglite://.data/parkshape

# Blob store adapter
# Where uploaded files and renders are kept: memory (lost on restart), local-fs (files under BLOB_DIR) or supabase (Supabase Storage).
BLOB_STORE=memory
# Absolute path of the directory that holds the blobs; empty unless BLOB_STORE=local-fs. pnpm dev:local uses .data/blobs.
BLOB_DIR=
# Supabase project URL, such as https://<project-ref>.supabase.co; empty unless BLOB_STORE=supabase.
SUPABASE_URL=
# Supabase service role key. Server only, never a VITE_ key; empty unless BLOB_STORE=supabase.
SUPABASE_SERVICE_KEY=
# Private Storage bucket that holds the blobs. Create it in the Supabase project first.
SUPABASE_BUCKET=parkshape

# Auth adapter
# Identity provider; mock signs in a local test user.
AUTH_PROVIDER=mock
# Secret of 32 characters or more that signs session cookies. Required unless DATABASE_URL is pglite://.
# Empty with pglite makes the API generate one and keep it next to the database, such as .data/parkshape.auth-secret.
AUTH_SECRET=
# Secure flag on the session cookie: auto (on unless CORS_ORIGIN is localhost or 127.0.0.1), on or off.
AUTH_COOKIE_SECURE=auto
# Access code of 8 characters or more that staff type to log in. Required unless CORS_ORIGIN is localhost or 127.0.0.1.
# Empty on a local origin leaves the staff login open. Keep the real value out of this file.
STAFF_ACCESS_CODE=

# AI adapter
# Model backend: openai-compatible (Gemini by default), rule-based, or fake (canned answers for tests).
# With openai-compatible, Gemini writes the answers when AI_API_KEY is set. The fixed rules write them when the key is empty or PARKSHAPE_OFFLINE is 1.
AI_PROVIDER=openai-compatible
# Base URL of an OpenAI-compatible endpoint, without /chat/completions. The default is Gemini.
# For OpenAI, use https://api.openai.com/v1.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# API key for the model endpoint, such as a Gemini API key. Server only; put it in .env, never in this file.
AI_API_KEY=
# Model name sent to the endpoint. The pages name it when it wrote an answer.
AI_MODEL=gemini-3.5-flash-lite
# Model asked when AI_MODEL answers 429 (rate limited). Gemini free-tier limits are per model, so it has its own quota. Set it to the same name as AI_MODEL to turn it off.
AI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Map tiles adapter
# Basemap tile source for the planner map: osm-raster for OpenStreetMap tiles, static for a plain offline fill in tests.
VITE_MAP_TILES=osm-raster

# Web client
# API origin the browser calls.
VITE_API_URL=http://localhost:8787
# Milliseconds between client refreshes of live data.
VITE_POLL_INTERVAL_MS=5000
# Exposes the editor state on window for the Playwright tests. Keep off outside test builds.
VITE_EDITOR_TEST_HOOK=off
# Shows the terraforming tools in the editor. The browser sees only VITE_ keys.
VITE_FEATURE_TERRAFORM=true
# Shows the Describe it option when starting a design. Keep it in step with FEATURE_DESCRIBE_IT.
VITE_FEATURE_DESCRIBE_IT=true

# Feature flags
# Enables free-text site descriptions.
FEATURE_DESCRIBE_IT=true
# Enables the generated submission summary.
FEATURE_SUMMARY=true
# Enables the terraforming tools.
FEATURE_TERRAFORM=true

# Rate limits
# Maximum votes accepted per client per minute.
RATE_LIMIT_VOTES_PER_MINUTE=30
# Maximum submissions accepted per client per hour.
RATE_LIMIT_SUBMISSIONS_PER_HOUR=10
# Maximum sign-ins accepted per client address per minute.
RATE_LIMIT_LOGINS_PER_MINUTE=20
# Maximum Describe it requests accepted per person per minute.
RATE_LIMIT_INTENTS_PER_MINUTE=10
# Maximum draft saves accepted per person per minute. Autosave sends at most 2 a second.
RATE_LIMIT_DRAFT_SAVES_PER_MINUTE=120
# Maximum thumbnail uploads accepted per person per hour.
RATE_LIMIT_THUMBNAILS_PER_HOUR=30
# Maximum comments on design elements accepted per person per minute.
RATE_LIMIT_COMMENTS_PER_MINUTE=10
# Where rate-limit counts are kept: memory (per API instance) or postgres (the DATABASE_URL database, shared by every instance).
RATE_LIMIT_STORE=memory
# true when a trusted proxy such as Vercel sets X-Forwarded-For, so sign-in limits count by the first address the proxies did not add. Leave false when callers reach the API directly.
TRUST_PROXY=false

# Live tests
# Set to 1 to let @live tests call real services. PR CI leaves it at 0.
PARKSHAPE_LIVE=0

# Offline mode
# Set to 1 to make every outbound request from the API fail at once. Use it to prove the local stack needs no network.
# pnpm dev:local sets it to 1 unless .env sets it to 0.
PARKSHAPE_OFFLINE=0

# Database tests
# A postgres:// server URL. When set, the db and API tests run on a fresh database there instead of pglite. Leave it empty to use pglite.
PARKSHAPE_TEST_DATABASE_URL=
