{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!coverage/**",
        "!dist/**",
        "!.turbo/**",
        "!test-results/**",
        "!playwright-report/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/vitest.shared.config.ts"
      ],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!coverage/**",
        "!dist/**",
        "!.turbo/**",
        "!test-results/**",
        "!playwright-report/**"
      ]
    },
    "test": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!coverage/**",
        "!dist/**",
        "!.turbo/**",
        "!test-results/**",
        "!playwright-report/**",
        "$TURBO_ROOT$/vitest.shared.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["PARKSHAPE_TEST_DATABASE_URL"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!e2e/**",
        "!coverage/**",
        "!dist/**",
        "!.turbo/**",
        "!test-results/**",
        "!playwright-report/**",
        "$TURBO_ROOT$/vitest.shared.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["PARKSHAPE_TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
