{
  "name": "commonground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.18"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "dev:local": "sh tools/dev-local.sh",
    "seed": "pnpm --filter @parkshape/db seed",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:quick": "tsx tools/preflight/src/test-quick-cli.ts",
    "typecheck": "turbo run typecheck",
    "e2e": "playwright test && pnpm --filter @parkshape/web test:e2e && pnpm --filter @parkshape/scene test:e2e",
    "e2e:local": "playwright test --reporter=list --trace=on",
    "lint": "pnpm lint:code && pnpm lint:style && pnpm lint:content && pnpm lint:format",
    "lint:code": "turbo run build --output-logs=errors-only && NODE_OPTIONS=--max-old-space-size=6144 eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:style": "stylelint \"**/*.css\" --allow-empty-input --cache --cache-location node_modules/.cache/stylelint/",
    "lint:content": "textlint --cache --cache-location node_modules/.cache/textlint/ \"**/*.md\" \"packages/db/seed/**/*.{md,txt}\" && node tools/textlint-rules/lint-locales.js",
    "lint:format": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettier-cache",
    "lint:deps": "depcruise apps packages tools && knip && jscpd .",
    "preflight": "tsx tools/preflight/src/cli.ts",
    "doctor": "tsx tools/preflight/src/cli.ts --doctor"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "9.39.5",
    "@parkshape/textlint-rule-content": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jscpd": "5.3.2",
    "knip": "5.88.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "stylelint": "16.26.1",
    "stylelint-declaration-strict-value": "1.10.11",
    "textlint": "15.8.0",
    "tsx": "4.23.15",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
